; STARTING ELEVEN FC — Godot 4
config_version=5

[application]
config/name="STARTING ELEVEN FC"
config/version="0.1.0"
config/icon="res://assets/branding/sefc-icon.png"
config/macos_native_icon="res://assets/branding/sefc.icns"
config/windows_native_icon="res://assets/branding/sefc.ico"
boot_splash/image="res://assets/branding/sefc-splash.png"
boot_splash/bg_color=Color(0.0353, 0.0902, 0.1137, 1)
boot_splash/stretch_mode=0
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "Mobile")
config/description="STARTING ELEVEN FC (SEFC) — Tepeden kamera ile 11'e 11 futbol."

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
renderer/rendering_method.web="gl_compatibility"
rendering_device/driver.macos="metal"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/positional_shadow/atlas_size=4096
environment/defaults/default_clear_color=Color(0.025, 0.045, 0.07, 1)

[physics]
common/physics_ticks_per_second=120
3d/default_gravity=9.81
