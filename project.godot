; Touchline — Godot 4
config_version=5

[application]
config/name="TOUCHLINE"
config/icon="res://assets/icon.svg"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/description="Tepeden kamera ile 11'e 11 futbol."

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
environment/defaults/default_clear_color=Color(0.025, 0.045, 0.07, 1)

[physics]
common/physics_ticks_per_second=120
3d/default_gravity=9.81
